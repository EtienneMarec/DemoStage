<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ConfigApp</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Copier les fichiers JSON de traduction dans le dossier de sortie -->
  <ItemGroup>
    <None Update="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
