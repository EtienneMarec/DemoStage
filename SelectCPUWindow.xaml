<Window x:Class="ConfigApp.SelectCPUWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select CPU"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <DockPanel LastChildFill="True">
        <!-- Title -->
        <TextBlock DockPanel.Dock="Top" x:Name="TitleBlock"
                   Text="Select CPU"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="20,20,20,10"
                   Foreground="#333333"/>
        
        <!-- Description -->
        <TextBlock DockPanel.Dock="Top" x:Name="DescriptionBlock"
                   Text="Choose a CPU to link"
                   FontSize="12"
                   Margin="20,0,20,10"
                   Foreground="#666666"
                   TextWrapping="Wrap"/>
        
        <!-- ComboBox -->
        <ComboBox DockPanel.Dock="Top" x:Name="CPUComboBox"
                  Margin="20,10,20,20"
                  Height="30"
                  FontSize="12"/>
        
        <!-- Button Panel -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,20,20,20">
            <Button Name="ValidateButton" Content="Validate" Width="140" Height="50" Margin="10,0,0,0"
                    Background="#0078D4" Foreground="White" FontSize="12" Click="ValidateButton_Click"/>
            <Button Name="CancelButton" Content="Cancel" Width="140" Height="50" Margin="10,0,0,0"
                    Background="#D0D0D0" Foreground="Black" FontSize="12" Click="CancelButton_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
