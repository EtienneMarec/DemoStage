<Window x:Class="ConfigApp.AddCentralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une Centrale"
        Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <DockPanel Margin="30">
        <!-- Title -->
        <TextBlock DockPanel.Dock="Top" x:Name="TitleBlock" Text="Ajouter une Centrale" FontSize="18" FontWeight="Bold" Margin="0,0,0,30"/>

        <!-- Type Selection -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TypeLabel" Text="Type:" FontSize="14" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox Grid.Column="1" x:Name="TypeComboBox" FontSize="13" Height="35" Padding="10,8" SelectedIndex="0">
                <ComboBoxItem Content="Centrale CPU" Tag="cpu"/>
                <ComboBoxItem Content="Centrale IHM" Tag="ihm"/>
                <ComboBoxItem Content="Centrale LM" Tag="lm"/>
            </ComboBox>
        </Grid>

        <!-- Buttons at bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddButton" Content="✓ Valider" Width="140" Height="50" Margin="0,0,15,0"
                    Background="#0078D4" Foreground="White" FontWeight="Bold" FontSize="13" Click="AddButton_Click"/>
            <Button x:Name="CancelButton" Content="✕ Annuler" Width="140" Height="50"
                    Background="#CCCCCC" Foreground="#333333" FontWeight="Bold" FontSize="13" Click="CancelButton_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
