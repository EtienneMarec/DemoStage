<Window x:Class="ConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindowElement"
        Title="Renard Doux - Configuration"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <MenuItem x:Name="MenuFiles" Header="Fichiers"/>
            <MenuItem x:Name="MenuTransfer" Header="Transfert"/>
            <MenuItem x:Name="MenuMonitor" Header="Moniteur"/>
            <MenuItem x:Name="MenuHelp" Header="Aide"/>
            <MenuItem x:Name="MenuMCS" Header="MCS"/>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="15">
            <DockPanel>
                <Button x:Name="ParametersButton" DockPanel.Dock="Left" Content="⚙ Paramètres" 
                        Width="120" Height="35" Margin="0,0,15,0"
                        Background="#0078D4" Foreground="White"
                        FontSize="12" FontWeight="Bold" Click="ParametersButton_Click"/>
                <Button x:Name="DetailsButton" DockPanel.Dock="Right" Content="Détails" 
                        Width="100" Height="35" Margin="15,0,0,0"
                        Background="#0078D4" Foreground="White"
                        FontSize="12" FontWeight="Bold"/>
                <TextBox x:Name="NameTextBox" DockPanel.Dock="Right" Margin="15,0,15,0"
                         Width="250" Height="35"
                         Padding="10,8"
                         FontSize="12"
                         Background="White"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Foreground="#333333"/>
            </DockPanel>
        </Border>

        <!-- Capteurs Grid -->
        <ScrollViewer Grid.Row="2" Padding="20">
            <Grid x:Name="SensorsGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
